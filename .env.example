# LLM Configuration
# Option 1: Local Ollama (recommended for development, no API key required)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Option 2: Groq Cloud API (fast inference)
GROQ_API_KEY=your_groq_api_key_here

# Option 3: OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# LLM Parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=500

# Vector Store
FAISS_INDEX_PATH=data/faiss_index
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Data
DATA_PATH=data/pdfs
